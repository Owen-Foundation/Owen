<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.owenfoundation.owenengine"
    android:versionCode="2"
    android:versionName="2.1.0">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">
        <activity
            android:name="org.owenfoundation.owenengine.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="intent.chess.provider.ENGINE" />
            </intent-filter>

            <meta-data
                android:name="chess.provider.engine.authority"
                android:value="org.owenfoundation.owenengine.OwenEngineProvider" />
        </activity>

        <provider
            android:name="org.owenfoundation.owenengine.OwenEngineProvider"
            android:authorities="org.owenfoundation.owenengine.OwenEngineProvider"
            android:exported="true" />
    </application>
</manifest>
